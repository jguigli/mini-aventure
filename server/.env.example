# Copy this file to server/.env (make env), then paste your key.
# server/.env is ignored by git: the key must never be committed.
OPENAI_API_KEY=
# Model used for generation and rewrites. Must support structured outputs.
# If empty, the server falls back to gpt-5.4-mini. The model in use is logged at startup.
OPENAI_MODEL=gpt-5.4-mini
# API server port (optional).
PORT=3001
